{
  "name": "imperial-court-bot",
  "version": "4.0.0",
  "description": "Multi-server utility and moderation runtime for Superior",
  "main": "dist/src/index.js",
  "scripts": {
    "check": "npm run format:check && npm run typecheck && npm test && npm run build",
    "dev": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "config:check": "tsx src/config-check-cli.ts",
    "db:check": "tsx src/storage/check-cli.ts",
    "format": "prettier --write .. --config ../.prettierrc.json --ignore-path ../.prettierignore",
    "format:check": "prettier --check .. --config ../.prettierrc.json --ignore-path ../.prettierignore",
    "migrate": "tsx src/storage/migrate-cli.ts",
    "start": "node dist/src/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "discord",
    "bot",
    "typescript"
  ],
  "author": "",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "better-sqlite3": "^12.9.0",
    "discord.js": "^14.27.0",
    "dotenv": "^17.4.2",
    "luxon": "^3.7.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/luxon": "^3.7.1",
    "@types/node": "^25.6.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
