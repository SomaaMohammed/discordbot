{
  "name": "superior-discord-bot",
  "version": "8.0.0",
  "description": "Multi-server utility and moderation runtime for Superior",
  "private": true,
  "main": "dist/src/index.js",
  "scripts": {
    "check": "bun run version:verify && bun run docs:links && bun run powershell:check && bun run format:check && bun run runtime:check && bun run test:policy && bun run typecheck && bun run test && bun run build && bun run syntax:check",
    "dev": "bun --no-env-file src/index.ts",
    "clean": "bun --no-env-file ../windows/clean-dist.mjs",
    "build": "bun run version:generate && bun run clean && bun --no-env-file ./node_modules/typescript/bin/tsc -p tsconfig.build.json",
    "config:check": "bun --no-env-file src/config-check-cli.ts",
    "db:backup": "bun --no-env-file src/storage/backup-cli.ts",
    "db:check": "bun --no-env-file src/storage/check-cli.ts",
    "db:checkpoint": "bun --no-env-file src/storage/checkpoint-cli.ts",
    "db:rotate": "bun --no-env-file src/storage/backup-rotation-cli.ts",
    "doctor": "bun --no-env-file src/storage/doctor-cli.ts",
    "docs:links": "bun --no-env-file ../scripts/check-markdown-links.mjs",
    "format": "bun --no-env-file ./node_modules/prettier/bin/prettier.cjs --write .. --config ../.prettierrc.json --ignore-path ../.prettierignore",
    "format:check": "bun --no-env-file ./node_modules/prettier/bin/prettier.cjs --check .. --config ../.prettierrc.json --ignore-path ../.prettierignore",
    "migrate": "bun --no-env-file src/storage/migrate-cli.ts",
    "security:check": "bun audit --audit-level=high && bun pm ls --all && bun --no-env-file ../scripts/security-check.mjs && bun run test:security",
    "version:generate": "bun --no-env-file ../scripts/version.mjs generate",
    "version:verify": "bun --no-env-file ../scripts/version.mjs verify",
    "version:bump": "bun --no-env-file ../scripts/version.mjs bump",
    "version:patch": "bun run version:bump -- patch",
    "version:minor": "bun run version:bump -- minor",
    "version:major": "bun run version:bump -- major",
    "package:win": "pwsh -NoLogo -NoProfile -ExecutionPolicy Bypass -File ../windows/build-portable.ps1 -OutputDirectory windows/.artifacts/development/release -StandaloneOutput windows/.artifacts/development/SuperiorBot.exe -UpdaterOutput windows/.artifacts/development/Update.exe -AllowUnsignedDevelopment",
    "package:win:verify": "pwsh -NoLogo -NoProfile -ExecutionPolicy Bypass -File ../windows/test-reproducible.ps1",
    "powershell:check": "bun --no-env-file ../scripts/check-powershell.mjs",
    "runtime:check": "bun --no-env-file ../scripts/runtime-policy.mjs",
    "artifact:verify": "pwsh -NoLogo -NoProfile -ExecutionPolicy Bypass -File ../windows/verify-release.ps1 -AllowUnsignedDevelopment",
    "release:build": "pwsh -NoLogo -NoProfile -ExecutionPolicy Bypass -File ../windows/release-build.ps1",
    "release:patch": "bun run version:patch && bun run release:build",
    "release:minor": "bun run version:minor && bun run release:build",
    "release:major": "bun run version:major && bun run release:build",
    "start": "bun --no-env-file dist/src/index.js",
    "syntax:check": "bun --no-env-file ../scripts/check-built-javascript.mjs",
    "typecheck": "bun --no-env-file ./node_modules/typescript/bin/tsc --noEmit -p tsconfig.json",
    "test": "bun --no-env-file ./node_modules/vitest/vitest.mjs run",
    "test:backup": "bun --no-env-file ./node_modules/vitest/vitest.mjs run tests/storage-backup.test.ts",
    "test:database": "bun --no-env-file ./node_modules/vitest/vitest.mjs run tests/storage-database.test.ts tests/storage-checkpoint.test.ts",
    "test:doctor": "bun --no-env-file ./node_modules/vitest/vitest.mjs run tests/storage-doctor.test.ts tests/storage-operator-cli.test.ts",
    "test:focused": "bun run test:database && bun run test:migration && bun run test:backup && bun run test:doctor && bun run test:rotation && bun run test:telemetry && bun run test:row-decoder",
    "test:migration": "bun --no-env-file ./node_modules/vitest/vitest.mjs run tests/storage-migration.test.ts",
    "test:policy": "bun --no-env-file ../scripts/test-policy.mjs",
    "test:rotation": "bun --no-env-file ./node_modules/vitest/vitest.mjs run tests/storage-backup-rotation.test.ts",
    "test:row-decoder": "bun --no-env-file ./node_modules/vitest/vitest.mjs run tests/storage-row-decoder.test.ts tests/storage-malformed-row.test.ts",
    "test:security": "bun --no-env-file ./node_modules/vitest/vitest.mjs run tests/ticket-authorization.test.ts tests/storage-multitenancy.test.ts tests/storage-backup.test.ts tests/persistent-panel-compatibility.test.ts tests/interaction-lifecycle.test.ts tests/logging-errors.test.ts tests/windows-packaging.test.ts tests/windows-source-identity.test.ts",
    "test:telemetry": "bun --no-env-file ./node_modules/vitest/vitest.mjs run tests/storage-telemetry.test.ts",
    "test:watch": "bun --no-env-file ./node_modules/vitest/vitest.mjs"
  },
  "keywords": [
    "discord",
    "bot",
    "typescript"
  ],
  "author": "",
  "license": "MIT",
  "type": "module",
  "packageManager": "bun@1.4.0",
  "engines": {
    "bun": ">=1.4.0"
  },
  "dependencies": {
    "discord.js": "^14.27.0",
    "dotenv": "^17.4.2",
    "luxon": "^3.7.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/bun": "1.4.0",
    "@types/luxon": "^3.7.1",
    "@types/node": "^25.6.0",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
