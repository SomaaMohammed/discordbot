# Copy to /etc/superior/superior.env and edit with sudoedit.
# Keep the file root-owned, group-readable by the service group, and mode 0640.
# Do not put secrets in a command line, unit file, shell history, or logs.

DISCORD_TOKEN=
COMMAND_REGISTRATION_MODE=global
DEV_GUILD_IDS=
BOT_OPERATOR_IDS=

# The service unit pins these values to the directories documented in
# docs/linux-deployment.md. Do not override them in production.
