[Unit]
Description=Superior Discord bot
After=network-online.target
Wants=network-online.target
ConditionPathExists=@INSTALL_ROOT@/current/tsbot/dist/src/index.js
ConditionPathExists=@ENV_FILE@
StartLimitIntervalSec=5min
StartLimitBurst=5

[Service]
Type=simple
User=@SERVICE_USER@
Group=@SERVICE_GROUP@
WorkingDirectory=@INSTALL_ROOT@/current
EnvironmentFile=@ENV_FILE@
Environment=ENV_FILE=@ENV_FILE@
Environment=SUPERIOR_APPLICATION_ROOT=@DATA_ROOT@
Environment=SUPERIOR_RELEASE_ROOT=@INSTALL_ROOT@/current
Environment=DB_FILE=@DATA_ROOT@/superior.db
Environment=SUPERIOR_BACKUP_DIR=@BACKUP_ROOT@
Environment=SUPERIOR_AUTO_MIGRATE=0
ExecStart=@BUN_PATH@ --no-env-file @INSTALL_ROOT@/current/tsbot/dist/src/index.js
Restart=on-failure
RestartSec=5s
TimeoutStartSec=90s
TimeoutStopSec=30s
KillSignal=SIGTERM
KillMode=mixed
UMask=0077
LimitNOFILE=65536
TasksMax=128
MemoryMax=1G
CPUQuota=200%
OOMPolicy=stop
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectHome=yes
ProtectSystem=strict
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=@DATA_ROOT@ @BACKUP_ROOT@
StandardOutput=journal
StandardError=journal
SyslogIdentifier=superior

[Install]
WantedBy=multi-user.target
