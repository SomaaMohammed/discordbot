# Required process configuration. Never commit a real token.
DISCORD_TOKEN=

# Shared SQLite database used by every guild. Relative paths resolve from the
# repository root.
DB_FILE=court.db

# Optional process-wide version override. Leave empty to use package version.
BOT_VERSION=

# Production uses global application commands. Use "guild" only for development
# and provide one or more comma-separated development guild snowflakes below.
COMMAND_REGISTRATION_MODE=global
DEV_GUILD_IDS=

# Reserved metadata only; this currently grants no runtime authority.
BOT_OPERATOR_USER_IDS=

# Bounded background-job concurrency shared by all guilds.
SCHEDULER_CONCURRENCY=4

# One-time v1 -> v2 migration input. Required only when a legacy database has
# rows. Remove it after a successful migration.
LEGACY_GUILD_ID=

# TEST_GUILD_ID is deliberately not a normal v2 key. The migration CLI accepts
# an existing TEST_GUILD_ID only as a deprecated LEGACY_GUILD_ID fallback.
