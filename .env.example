# Required process configuration. Never commit a real token.
DISCORD_TOKEN=

# Shared SQLite database used by every guild. Relative paths resolve from the
# application root (the repository root in source installs, or the folder
# containing SuperiorBot.exe in the portable Windows build).
DB_FILE=superior.db

# Optional trusted directory for doctor, compiled maintenance, and scheduled
# backup rotation. Relative paths resolve from the same application root.
SUPERIOR_BACKUP_DIR=backups

# Production uses global application commands. Use "guild" only for development
# and provide one or more comma-separated development guild snowflakes below.
COMMAND_REGISTRATION_MODE=global
DEV_GUILD_IDS=

# Optional: one or more deployment-owner Discord IDs for the visible
# /operator status and explicit guild suspend/resume recovery controls.
BOT_OPERATOR_IDS=
